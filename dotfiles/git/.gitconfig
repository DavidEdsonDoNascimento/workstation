[include]
    path = ~/.gitconfig.local

[includeIf "gitdir:~/www/altaa/"]
    path = ~/.gitconfig.altaa

[user]
    useConfigOnly = true

[init]
    defaultBranch = main

[core]
    editor = nvim

[fetch]
    prune = true

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true

[commit]
    verbose = true
